# Required for live mode (without them the app runs on mock data)
EXA_API_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Optional tech challenges — off by default
ENABLE_OXYLABS=false
OXYLABS_USERNAME=
OXYLABS_PASSWORD=

ENABLE_ELEVENLABS=false
ELEVENLABS_API_KEY=

# Force mock mode even if keys are set (handy for offline demos)
FORCE_MOCKS=false

# Use saved example API responses instead of calling Exa or Gemini
USE_MOCK=false
