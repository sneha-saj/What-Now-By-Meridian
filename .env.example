# Required for live mode (without them the app runs on mock data)
EXA_API_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Optional: Context.dev reads whole official pages (Migri rule page, perk pages) for exact details; Exa is used if it fails
CONTEXT_DEV_API_KEY=

# Optional: Modal deployment credentials (not used by the running app)
MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=

# Optional tech challenges — off by default
# Optional: ElevenLabs voice typing (speech to text) and "Listen" (read steps aloud)
ELEVENLABS_API_KEY=

# Force mock mode even if keys are set (handy for offline demos)
FORCE_MOCKS=false

# Use saved example API responses instead of calling Exa or Gemini
USE_MOCK=false

# Access codes for judges (comma-separated). If set, only requests with a valid code use the paid APIs; everyone
# else gets the free demo mode. Share a code privately, e.g. as a link: https://<site>/start?code=<code>
# Leave empty to keep live mode for everyone (local development).
ACCESS_CODES=
